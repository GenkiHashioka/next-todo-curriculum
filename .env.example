# このファイルをコピーして .env を作ります。
# Dev Container を使う場合は初回セットアップで自動生成されるので、手作業は不要です。
#
#   cp .env.example .env
#
# 値はそのままで動きます（学習用のローカル環境のため）。

# --- データベース ------------------------------------------------------------
# DB_HOST はコンテナのサービス名。アプリと DB は同じ Docker ネットワーク上にいるので、
# localhost ではなく db で解決する。
DB_HOST=db
DB_NAME=todos
DB_USER=admin
DB_PASSWORD=password

# コンテナ内での PostgreSQL のポート
DB_CONTAINER_PORT=5432
# ホスト側に公開するポート。GUI クライアントから DB を覗きたいときに使う。
# 5432 は他のプロジェクトと衝突しやすいのでずらしてある。
DB_LOCAL_PORT=5431

DB_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_CONTAINER_PORT}/${DB_NAME}

# --- アプリケーション --------------------------------------------------------
# NODE_ENV はここに書かないこと。
# Next.js が自動で設定する（開発は development、ビルドは production）。
# 手で development を指定すると、本番ビルドが壊れる。

# JWT の署名に使う秘密鍵。長いランダムな文字列であれば何でもよい。
# Dev Container の初回セットアップで自動生成される。
# 手動で作る場合: openssl rand -base64 48
JWT_SECRET=

# --- DB コンテナのヘルスチェック ---------------------------------------------
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=5
